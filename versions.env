# Shared software versions for local development, CI, releases, and test labs.
# Source from any POSIX shell: . /path/to/gnmic/versions.env
# Keep entries as unquoted export NAME=value lines, with comments on separate
# lines, so Make can include this file and CI can load it into GITHUB_ENV.

# Build, lint, and release tools.
export GO_VERSION=1.26.5
export GOLANGCI_LINT_VERSION=v1.46
export GORELEASER_VERSION=v2.13.3

# Documentation tooling. Run make sync-versions after changing PYTHON_VERSION
# to regenerate the tracked .python-version file. Package versions are in uv.lock.
export UV_VERSION=0.12.10
export PYTHON_VERSION=3.12

# Container build base and integration-test images. Existing floating tags are
# explicit here; changing them to fixed releases is a separate upgrade.
export ALPINE_VERSION=latest
export GNMIC_TEST_VERSION=0.0.0-rc1
export SRLINUX_VERSION=23.10.3
export SRLINUX_ROLLING_VERSION=latest
export CONSUL_VERSION=latest
export CONSUL_LOADERS_VERSION=1.15.4
export NATS_VERSION=latest
export KAFKA_VERSION=latest
export ZOOKEEPER_VERSION=latest
export INFLUXDB_VERSION=1.8.10
export PROMETHEUS_VERSION=latest
export GRAFANA_VERSION=latest
